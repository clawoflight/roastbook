{
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Bricolage Grotesque",
      "$extensions": {
        "dev.openpencil": {
          "codeSyntax": {
            "WEB": "var(--font-display)"
          },
          "scopes": [
            "FONT_FAMILY"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Hanken Grotesk",
      "$extensions": {
        "dev.openpencil": {
          "codeSyntax": {
            "WEB": "var(--font-sans)"
          },
          "scopes": [
            "FONT_FAMILY"
          ]
        }
      }
    }
  }
}
