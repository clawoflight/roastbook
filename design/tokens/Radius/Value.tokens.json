{
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 12,
        "unit": "px"
      },
      "$extensions": {
        "dev.openpencil": {
          "codeSyntax": {
            "WEB": "var(--radius-sm)"
          },
          "scopes": [
            "CORNER_RADIUS"
          ]
        }
      }
    },
    "md": {
